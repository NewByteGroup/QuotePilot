# Names only. Copy to .env and fill in; never commit .env.

# Bootstrap superuser of the local Postgres container
POSTGRES_USER=
# Password of the bootstrap superuser
POSTGRES_PASSWORD=
# Database name
POSTGRES_DB=
# Host port mapped to Postgres (defaults to 5432 if empty)
POSTGRES_PORT=
# Password for the qp_migrator role (schema owner, runs migrations)
QP_MIGRATOR_PASSWORD=
# Password for the qp_app role (NOBYPASSRLS, used by core-api)
QP_APP_PASSWORD=
# Password for the qp_admin role (platform path only — teardown and platform_* functions)
QP_ADMIN_PASSWORD=
# DSN for qp_app; used by core-api and integration tests
# shape: postgres://qp_app:<QP_APP_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>?sslmode=disable
POSTGRES_DSN=
# DSN for qp_admin; platform path only — teardown and platform_* functions. Not used by tenant request paths.
# shape: postgres://qp_admin:<QP_ADMIN_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>?sslmode=disable
QP_ADMIN_DSN=
# DSN for qp_migrator; migrations only. Migrations must run as qp_migrator, never as the bootstrap superuser.
# shape: postgres://qp_migrator:<QP_MIGRATOR_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>?sslmode=disable
MIGRATOR_DSN=
# DSN for the bootstrap superuser; only integration tests that need CREATE DATABASE
# (the populated-v1 upgrade-guard test in internal/migrate) use it — qp_migrator is NOCREATEDB.
# shape: postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>?sslmode=disable
PG_SUPER_DSN=
# Base URL of core-api
CORE_API_URL=
# Base URL of ai-engine
AI_ENGINE_URL=
# Base URL of the web app
WEB_URL=

# --- Auth/session (internal/platform, spec 2026-11-10-tenant-resolution-api section 6) ---
# HS256 access-token keys, comma-separated kid=secret pairs; the first entry
# signs new tokens unless AUTH_JWT_ACTIVE_KID names another kid in the list
AUTH_JWT_KEYS=
# kid inside AUTH_JWT_KEYS used to sign new access tokens (defaults to the first entry)
AUTH_JWT_ACTIVE_KID=
# Access-token lifetime as a Go duration (default 15m)
AUTH_JWT_ACCESS_TTL=
# Refresh-cookie lifetime as a Go duration (default 720h = 30d; ParseDuration has no day unit)
AUTH_JWT_REFRESH_TTL=
# Magic-link token lifetime as a Go duration (default 15m)
AUTH_LOGIN_TTL=
# Secure flag on auth cookies (default true; set 0 or false only for local http)
AUTH_COOKIE_SECURE=
# Resend API key for magic-link mail; set together with AUTH_MAGIC_FROM, or leave both empty for the dev/test sender
RESEND_API_KEY=
# From: address for magic-link mail
AUTH_MAGIC_FROM=
# Svix signing secret for the Resend inbound webhook (whsec_...); unset means the webhook route is not mounted
RESEND_WEBHOOK_SECRET=
# Port the API binds (default 8080)
PORT=
