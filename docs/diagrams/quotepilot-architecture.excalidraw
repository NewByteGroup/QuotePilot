: 2056.25, "width": 493.95, "height": 37.5, "angle": -0.02, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1109932625, "version": 1, "versionNonce": 1921172563, "isDeleted": false, "boundElements": [], "updated": 1730900000000, "link": null, "locked": false, "text": "💡 Job args = IDs only. River's tables sit outside tenant RLS,\nso no tenant content in them.", "fontSize": 15, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "qp00188", "originalText": "💡 Job args = IDs only. River's tables sit outside tenant RLS,\nso no tenant content in them.", "autoResize": true, "lineHeight": 1.25, "baseline": 13}, {"id": "qp00190", "type": "rectangle", "x": 620, "y": 2030, "width": 520, "height": 90, "angle": 0.015, "strokeColor": "#f08c00", "backgroundColor": "#fff3a3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 2054255925, "version": 1, "versionNonce": 295755232, "isDeleted": false, "boundElements": [{"type": "text", "id": "qp00191"}], "updated": 1730900000000, "link": null, "locked": false}, {"id": "qp00191", "type": "text", "x": 638.125, "y": 2056.25, "width": 483.75, "height": 37.5, "angle": 0.015, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 344436360, "version": 1, "versionNonce": 1419965406, "isDeleted": false, "boundElements": [], "updated": 1730900000000, "link": null, "locked": false, "text": "♻️ Retry or replay = no repeated LLM calls. Every stage is a\ncheckpoint.", "fontSize": 15, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "qp00190", "originalText": "♻️ Retry or replay = no repeated LLM calls. Every stage is a\ncheckpoint.", "autoResize": true, "lineHeight": 1.25, "baseline": 13}, {"id": "qp00192", "type": "rectangle", "x": 1180, "y": 2030, "width": 520, "height": 90, "angle": -0.02, "strokeColor": "#f08c00", "backgroundColor": "#fff3a3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1813280914, "version": 1, "versionNonce": 399443173, "isDeleted": false, "boundElements": [{"type": "text", "id": "qp00193"}], "updated": 1730900000000, "link": null, "locked": false}, {"id": "qp00193", "type": "text", "x": 1201.725, "y": 2056.25, "width": 476.55, "height": 37.5, "angle": -0.02, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 837457289, "version": 1, "versionNonce": 585848354, "isDeleted": false, "boundElements": [], "updated": 1730900000000, "link": null, "locked": false, "text": "☠️ Out of retries → dead-letter → RFQ = FAILED → visible in\nthe tenant's inbox.", "fontSize": 15, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "qp00192", "originalText": "☠️ Out of retries → dead-letter → RFQ = FAILED → visible in\nthe tenant's inbox.", "autoResize": true, "lineHeight": 1.25, "baseline": 13}, {"id": "qp00194", "type": "rectangle", "x": 1740, "y": 2030, "width": 520, "height": 90, "angle": 0.015, "strokeColor": "#f08c00", "backgroundColor": "#fff3a3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 913441352, "version": 1, "versionNonce": 1144632220, "isDeleted": false, "boundElements": [{"type": "text", "id": "qp00195"}], "updated": 1730900000000, "link": null, "locked": false}, {"id":